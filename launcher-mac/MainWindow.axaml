<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:DustoreLauncherV.Mac.ViewModels"
        x:Class="DustoreLauncherV.Mac.MainWindow"
        x:CompileBindings="False"
        Title="DUSTORE LAUNCHER V"
        Width="1180" Height="760" MinWidth="880" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="#0A101B">
  <Window.Styles>
    <Style Selector="TextBlock">
      <Setter Property="Foreground" Value="#E7EFF9" />
      <Setter Property="FontSize" Value="14" />
    </Style>
    <Style Selector="TextBlock.muted"><Setter Property="Foreground" Value="#91A2BA" /></Style>
    <Style Selector="TextBlock.eyebrow"><Setter Property="Foreground" Value="#6DCCEB" /><Setter Property="FontSize" Value="11" /><Setter Property="FontWeight" Value="SemiBold" /></Style>
    <Style Selector="TextBlock.title"><Setter Property="FontSize" Value="28" /><Setter Property="FontWeight" Value="SemiBold" /></Style>
    <Style Selector="Button">
      <Setter Property="Background" Value="#182438" /><Setter Property="Foreground" Value="#E7EFF9" />
      <Setter Property="BorderBrush" Value="#2A3B54" /><Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="7" /><Setter Property="Padding" Value="16,10" />
      <Setter Property="MinHeight" Value="40" /><Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button:pointerover /template/ ContentPresenter"><Setter Property="Background" Value="#243A51" /></Style>
    <Style Selector="Button.primary"><Setter Property="Background" Value="#20A9D8" /><Setter Property="Foreground" Value="#06131E" /><Setter Property="BorderBrush" Value="#4DC6E8" /><Setter Property="FontWeight" Value="SemiBold" /></Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter"><Setter Property="Background" Value="#50C6E7" /></Style>
    <Style Selector="Button.nav"><Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" /><Setter Property="HorizontalContentAlignment" Value="Left" /><Setter Property="Padding" Value="16,12" /></Style>
    <Style Selector="TextBox"><Setter Property="Background" Value="#0C1522" /><Setter Property="BorderBrush" Value="#2C3A50" /><Setter Property="CornerRadius" Value="6" /><Setter Property="Foreground" Value="#ECF3FB" /><Setter Property="MinHeight" Value="40" /><Setter Property="Padding" Value="12,9" /></Style>
    <Style Selector="ComboBox"><Setter Property="Background" Value="#0C1522" /><Setter Property="BorderBrush" Value="#2C3A50" /><Setter Property="CornerRadius" Value="6" /><Setter Property="Foreground" Value="#ECF3FB" /><Setter Property="MinHeight" Value="40" /><Setter Property="HorizontalAlignment" Value="Stretch" /></Style>
    <Style Selector="Border.card"><Setter Property="Background" Value="#111D2E" /><Setter Property="BorderBrush" Value="#24354C" /><Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="10" /><Setter Property="Padding" Value="22" /></Style>
    <Style Selector="ListBox"><Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" /><Setter Property="Padding" Value="0" /></Style>
    <Style Selector="ListBoxItem"><Setter Property="Padding" Value="10" /><Setter Property="Margin" Value="0,0,0,4" /><Setter Property="CornerRadius" Value="7" /></Style>
    <Style Selector="ListBoxItem:selected /template/ ContentPresenter"><Setter Property="Background" Value="#173754" /><Setter Property="BorderBrush" Value="#32B9E2" /><Setter Property="BorderThickness" Value="1" /></Style>
  </Window.Styles>

  <Grid RowDefinitions="76,*,Auto">
    <Border Grid.Row="0" Background="#101B2A" BorderBrush="#26364A" BorderThickness="0,0,0,1" Padding="24,12">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
          <Image Source="avares://DustoreLauncherV.Mac/Assets/dustore-logo-original.png" Width="50" Height="42" Stretch="Uniform" />
          <StackPanel Spacing="1" VerticalAlignment="Center">
            <TextBlock FontSize="21" FontWeight="Bold" Text="DUSTORE V" />
            <TextBlock Classes="eyebrow" Text="LAUNCHER · macOS" />
          </StackPanel>
        </StackPanel>
        <TextBlock Grid.Column="2" Classes="muted" Text="{Binding PlatformLabel}" VerticalAlignment="Center" />
      </Grid>
    </Border>

    <Grid Grid.Row="1" ColumnDefinitions="208,*">
      <Border Background="#0D1623" BorderBrush="#223044" BorderThickness="0,0,1,0" Padding="14,24,14,18">
        <Grid RowDefinitions="Auto,*,Auto">
          <StackPanel Spacing="7">
            <TextBlock Classes="eyebrow" Text="ВАШИ ИГРЫ" Margin="16,0,0,12" />
            <Button Name="LibraryNav" Classes="nav" Content="Библиотека" Command="{Binding LibraryCommand}" />
            <Button Name="ExNav" Classes="nav" Content="eX · перенос игр" Command="{Binding ExCommand}" />
            <Button Classes="nav" Command="{Binding StoreCommand}" ToolTip.Tip="Открыть Dustore в браузере">
              <StackPanel Spacing="2"><TextBlock Text="Магазин Dustore ↗" /><TextBlock Classes="muted" FontSize="11" Text="Откроется в браузере" /></StackPanel>
            </Button>
            <Separator Background="#243348" Margin="12,16" />
            <Button Name="SettingsNav" Classes="nav" Content="Настройки" Command="{Binding SettingsCommand}" />
          </StackPanel>
          <StackPanel Grid.Row="2" Spacing="8" Margin="14,0">
            <TextBlock Classes="muted" FontSize="12" Text="Библиотека и eX работают внутри приложения." TextWrapping="Wrap" />
            <TextBlock Classes="eyebrow" Text="WINDOWS ↔ macOS" />
          </StackPanel>
        </Grid>
      </Border>

      <Grid Grid.Column="1" IsVisible="{Binding IsLibrary}" Margin="24">
        <Grid RowDefinitions="Auto,*">
          <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,20">
            <StackPanel Spacing="4"><TextBlock Classes="title" Text="Библиотека" /><TextBlock Classes="muted" Text="{Binding LibraryCount}" /></StackPanel>
            <Button Grid.Column="1" Margin="12,0,8,0" Content="Добавить файл" Click="AddGameFile_Click" IsEnabled="{Binding NotBusy}" VerticalAlignment="Center" />
            <Button Grid.Column="2" Classes="primary" Content="Добавить .app / папку" Click="AddGameFolder_Click" IsEnabled="{Binding NotBusy}" VerticalAlignment="Center" />
          </Grid>
          <Grid Grid.Row="1" ColumnDefinitions="240,18,*">
            <Border Classes="card" Padding="12">
              <Grid RowDefinitions="Auto,Auto,*,Auto">
                <TextBox Watermark="Поиск в библиотеке" Text="{Binding Search, Mode=TwoWay}" />
                <TextBlock Grid.Row="1" Classes="muted" FontSize="11" Text="{Binding FilterCount}" Margin="5,12" />
                <ListBox Grid.Row="2" Name="GamesList" ItemsSource="{Binding Games}" SelectedItem="{Binding SelectedGame, Mode=TwoWay}" DoubleTapped="GamesList_DoubleTapped">
                  <ListBox.ItemTemplate>
                    <DataTemplate DataType="vm:GameItemViewModel">
                      <StackPanel Spacing="4">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Status}" Classes="muted" FontSize="11" TextWrapping="Wrap" />
                      </StackPanel>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
                <Button Grid.Row="3" Content="Обновить" Command="{Binding RefreshCommand}" Margin="0,8,0,0" />
              </Grid>
            </Border>
            <ScrollViewer Grid.Column="2" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
              <StackPanel Spacing="16">
                <Border Classes="card" IsVisible="{Binding NoSelection}" Padding="28">
                  <StackPanel Spacing="18">
                    <TextBlock Classes="eyebrow" Text="ВСЁ НАЧИНАЕТСЯ С ИГРЫ" />
                    <TextBlock FontSize="24" FontWeight="SemiBold" Text="Добавьте свою первую игру" TextWrapping="Wrap" />
                    <TextBlock Classes="muted" Text="Выберите готовое приложение .app, ZIP игры или исходную Windows-сборку. eX проверит возможность переноса для Mac." TextWrapping="Wrap" />
                    <Button Classes="primary" Content="Выбрать игру" Click="AddGameFile_Click" IsEnabled="{Binding NotBusy}" HorizontalAlignment="Left" />
                  </StackPanel>
                </Border>
                <StackPanel Spacing="16" IsVisible="{Binding HasSelection}">
                  <Border Classes="card" Padding="28">
                    <StackPanel Spacing="16">
                      <TextBlock Classes="eyebrow" Text="ВАША ИГРА" />
                      <TextBlock Classes="title" Text="{Binding SelectedTitle}" TextWrapping="Wrap" />
                      <TextBlock Classes="muted" Text="{Binding SelectedStatus}" TextWrapping="Wrap" />
                      <WrapPanel Orientation="Horizontal">
                        <Button Classes="primary" Content="{Binding LaunchLabel}" Command="{Binding LaunchCommand}" MinWidth="152" MinHeight="48" Margin="0,0,10,10" />
                        <Button Content="Перенести через eX" Command="{Binding ConvertGameCommand}" Margin="0,0,10,10" />
                        <Button Content="Папка" Command="{Binding RevealGameCommand}" Margin="0,0,0,10" />
                      </WrapPanel>
                      <TextBlock Classes="muted" Text="{Binding LaunchHint}" TextWrapping="Wrap" FontSize="12" />
                    </StackPanel>
                  </Border>
                  <Border Classes="card">
                    <StackPanel Spacing="12">
                      <TextBlock FontWeight="SemiBold" Text="Файлы и история" />
                      <TextBlock Classes="muted" FontSize="11" Text="ИСХОДНАЯ СБОРКА" />
                      <SelectableTextBlock Text="{Binding SelectedSource}" Foreground="#BACADD" TextWrapping="Wrap" FontSize="12" />
                      <Grid ColumnDefinitions="*,*" Margin="0,8,0,4">
                        <StackPanel Spacing="5"><TextBlock Classes="muted" FontSize="11" Text="ДОБАВЛЕНА" /><TextBlock Text="{Binding SelectedAdded}" FontSize="12" /></StackPanel>
                        <StackPanel Grid.Column="1" Spacing="5"><TextBlock Classes="muted" FontSize="11" Text="ПОСЛЕДНИЙ ЗАПУСК" /><TextBlock Text="{Binding SelectedLastPlayed}" FontSize="12" TextWrapping="Wrap" /></StackPanel>
                      </Grid>
                      <Button Content="Убрать из библиотеки" Command="{Binding RemoveGameCommand}" HorizontalAlignment="Left" ToolTip.Tip="Удаляется только запись. Исходные файлы остаются на диске." />
                    </StackPanel>
                  </Border>
                </StackPanel>
              </StackPanel>
            </ScrollViewer>
          </Grid>
        </Grid>
      </Grid>

      <Grid Grid.Column="1" IsVisible="{Binding IsEx}" Margin="24" RowDefinitions="Auto,*,Auto">
        <StackPanel Spacing="5" Margin="0,0,0,18">
          <TextBlock Classes="eyebrow" Text="WINDOWS ↔ macOS" />
          <TextBlock Classes="title" Text="eX · перенос игр" />
          <TextBlock Classes="muted" Text="Проверка сборки, подбор движка и создание отдельного ZIP." TextWrapping="Wrap" />
        </StackPanel>
        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
          <StackPanel Spacing="16" Margin="0,0,8,16">
            <Border Classes="card">
              <StackPanel Spacing="12">
                <TextBlock FontWeight="SemiBold" Text="1 · Исходная игра" />
                <TextBox Watermark="Путь к .exe, .app, .zip, .pck или папке игры" Text="{Binding SourcePath, Mode=TwoWay}" IsEnabled="{Binding NotBusy}" />
                <WrapPanel>
                  <Button Content="Выбрать файл" Click="SelectSourceFile_Click" IsEnabled="{Binding NotBusy}" Margin="0,0,8,0" />
                  <Button Content="Выбрать .app / папку" Click="SelectSourceFolder_Click" IsEnabled="{Binding NotBusy}" Margin="0,0,8,0" />
                  <Button Content="Анализировать" Command="{Binding AnalyzeCommand}" />
                </WrapPanel>
              </StackPanel>
            </Border>
            <Border Classes="card">
              <StackPanel Spacing="12">
                <TextBlock FontWeight="SemiBold" Text="2 · Целевая система" />
                <Grid ColumnDefinitions="*,16,*">
                  <StackPanel Spacing="7"><TextBlock Classes="muted" FontSize="12" Text="Система" /><ComboBox ItemsSource="{Binding Targets}" SelectedItem="{Binding SelectedTarget, Mode=TwoWay}" IsEnabled="{Binding NotBusy}"><ComboBox.ItemTemplate><DataTemplate DataType="vm:TargetChoice"><TextBlock Text="{Binding Label}" /></DataTemplate></ComboBox.ItemTemplate></ComboBox></StackPanel>
                  <StackPanel Grid.Column="2" Spacing="7"><TextBlock Classes="muted" FontSize="12" Text="Процессор Mac" /><ComboBox ItemsSource="{Binding Architectures}" SelectedItem="{Binding SelectedArchitecture, Mode=TwoWay}" IsEnabled="{Binding CanChooseArchitecture}"><ComboBox.ItemTemplate><DataTemplate DataType="vm:ArchitectureChoice"><TextBlock Text="{Binding Label}" /></DataTemplate></ComboBox.ItemTemplate></ComboBox></StackPanel>
                </Grid>
                <TextBlock Classes="muted" FontSize="12" Text="Для Windows используется x64. Для Mac выбирайте процессор компьютера, на котором будет запускаться игра." TextWrapping="Wrap" />
                <TextBlock Classes="muted" FontSize="12" Text="Название игры" />
                <TextBox Text="{Binding GameName, Mode=TwoWay}" Watermark="Название для готового пакета" IsEnabled="{Binding NotBusy}" />
              </StackPanel>
            </Border>
            <Border Classes="card">
              <StackPanel Spacing="12">
                <TextBlock Classes="eyebrow" Text="{Binding PlanFacts}" TextWrapping="Wrap" />
                <TextBlock FontSize="20" FontWeight="SemiBold" Text="{Binding PlanTitle}" TextWrapping="Wrap" />
                <TextBlock Classes="muted" Text="{Binding PlanDetail}" TextWrapping="Wrap" />
                <Expander Header="Проверки совместимости" IsVisible="{Binding HasWarnings}"><SelectableTextBlock Text="{Binding PlanWarnings}" TextWrapping="Wrap" Foreground="#B7C8DB" FontSize="12" /></Expander>
                <Expander Header="Дополнительные параметры движка">
                  <StackPanel Spacing="8" Margin="0,10,0,0">
                    <TextBlock Classes="muted" FontSize="12" Text="Версия движка. Для Godot должна совпадать с исходной игрой." TextWrapping="Wrap" />
                    <TextBox Text="{Binding RuntimeVersion, Mode=TwoWay}" Watermark="Например: 4.7.1" IsEnabled="{Binding NotBusy}" />
                    <TextBlock Classes="muted" FontSize="12" Text="Runtime вручную (необязательно). Пустое поле — официальный источник с проверкой контрольной суммы." TextWrapping="Wrap" />
                    <TextBox Text="{Binding RuntimePath, Mode=TwoWay}" Watermark="Путь к официальному пакету движка" IsEnabled="{Binding NotBusy}" />
                    <Button Content="Выбрать runtime" Click="SelectRuntime_Click" IsEnabled="{Binding NotBusy}" HorizontalAlignment="Left" />
                  </StackPanel>
                </Expander>
              </StackPanel>
            </Border>
            <Border Classes="card" IsVisible="{Binding HasResult}">
              <StackPanel Spacing="12"><TextBlock FontWeight="SemiBold" Text="Готовый пакет" /><SelectableTextBlock Text="{Binding ResultPath}" TextWrapping="Wrap" Foreground="#7FDBEF" /><Button Content="Показать в Finder" Command="{Binding RevealOutputCommand}" HorizontalAlignment="Left" /></StackPanel>
            </Border>
            <Expander Header="Журнал переноса"><SelectableTextBlock Text="{Binding ProgressLog}" TextWrapping="Wrap" Foreground="#B7C8DB" FontSize="12" /></Expander>
          </StackPanel>
        </ScrollViewer>
        <Border Grid.Row="2" Background="#132134" BorderBrush="#2A4059" BorderThickness="1" CornerRadius="9" Padding="18,14">
          <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto">
            <TextBlock Classes="eyebrow" Text="3 · НОВЫЙ ZIP, ИСХОДНАЯ ИГРА СОХРАНЯЕТСЯ" Margin="0,0,0,8" />
            <Button Grid.Column="1" Grid.RowSpan="2" Classes="primary" Content="Создать пакет" Command="{Binding ConvertCommand}" Margin="18,0,0,0" MinHeight="48" VerticalAlignment="Center" />
            <Grid Grid.Row="1" ColumnDefinitions="*,Auto">
              <TextBox Text="{Binding OutputPath, Mode=TwoWay}" Watermark="Путь нового ZIP" IsEnabled="{Binding NotBusy}" />
              <Button Grid.Column="1" Content="…" Click="SelectOutput_Click" IsEnabled="{Binding NotBusy}" Margin="8,0,0,0" Padding="12,8" ToolTip.Tip="Выбрать путь ZIP" />
            </Grid>
          </Grid>
        </Border>
      </Grid>

      <ScrollViewer Grid.Column="1" IsVisible="{Binding IsSettings}" Margin="24" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="18" MaxWidth="780" HorizontalAlignment="Left">
          <TextBlock Classes="title" Text="Настройки" />
          <Border Classes="card"><StackPanel Spacing="12"><TextBlock FontWeight="SemiBold" Text="Библиотека Mac" /><TextBlock Classes="muted" Text="Записи, подготовленные приложения и результаты находятся в отдельном профиле Mac." TextWrapping="Wrap" /><SelectableTextBlock Text="{Binding DataDirectory}" TextWrapping="Wrap" Foreground="#BBCBDE" FontSize="12" /><Button Content="Открыть папку библиотеки" Command="{Binding RevealDataCommand}" HorizontalAlignment="Left" /></StackPanel></Border>
          <Border Classes="card"><StackPanel Spacing="12"><TextBlock FontWeight="SemiBold" Text="Движки eX" /><TextBlock Classes="muted" Text="Официальные движки загружаются по мере необходимости и используются повторно после проверки контрольной суммы." TextWrapping="Wrap" /><SelectableTextBlock Text="{Binding CacheDirectory}" TextWrapping="Wrap" Foreground="#BBCBDE" FontSize="12" /><Button Content="Открыть кэш движков" Command="{Binding RevealCacheCommand}" HorizontalAlignment="Left" /></StackPanel></Border>
          <Border Classes="card"><StackPanel Spacing="12"><TextBlock FontWeight="SemiBold" Text="DUSTORE LAUNCHER V · macOS" /><TextBlock Classes="muted" Text="Нативная библиотека Mac и перенос Windows ↔ macOS через eX. Магазин открывается в системном браузере. Поддержка переноса зависит от движка и платформенных зависимостей конкретной игры." TextWrapping="Wrap" /><TextBlock Classes="muted" Text="APK-конвертация, облачный аккаунт и функции Windows-устройств в эту версию Mac не включены." TextWrapping="Wrap" FontSize="12" /></StackPanel></Border>
        </StackPanel>
      </ScrollViewer>
    </Grid>

    <Border Grid.Row="2" Background="#101B2A" BorderBrush="#24354B" BorderThickness="0,1,0,0" Padding="20,11">
      <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto">
        <StackPanel Spacing="7">
          <ProgressBar IsVisible="{Binding IsBusy}" IsIndeterminate="True" Height="3" />
          <TextBlock Classes="muted" Text="{Binding Status}" TextWrapping="Wrap" FontSize="12" />
        </StackPanel>
        <Button Grid.Column="1" Content="Отменить" Command="{Binding CancelCommand}" IsVisible="{Binding IsBusy}" Margin="16,0,0,0" VerticalAlignment="Center" />
        <SelectableTextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding Error}" IsVisible="{Binding HasError}" Foreground="#FF9DAD" TextWrapping="Wrap" FontSize="12" Margin="0,6,0,0" />
      </Grid>
    </Border>
  </Grid>
</Window>
