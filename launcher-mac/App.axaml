<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="DustoreLauncherV.Mac.App"
             Name="DUSTORE LAUNCHER V"
             RequestedThemeVariant="Dark">
  <Application.Resources>
    <!-- Apple-style dark materials: graphite surfaces, hairlines and soft shadows. The DUSTORE
         pink and yellow stay as the only accents. No glows, no gradients. -->
    <SolidColorBrush x:Key="Background" Color="#0E0D10" />
    <SolidColorBrush x:Key="BackgroundSoft" Color="#151418" />
    <SolidColorBrush x:Key="NavBackground" Color="#121114" />
    <SolidColorBrush x:Key="NavTranslucent" Color="#B8141317" />
    <SolidColorBrush x:Key="Surface" Color="#1C1B20" />
    <SolidColorBrush x:Key="SurfaceRaised" Color="#232227" />
    <SolidColorBrush x:Key="SurfaceHover" Color="#2A2930" />
    <SolidColorBrush x:Key="SurfacePressed" Color="#18171B" />
    <SolidColorBrush x:Key="Fill" Color="#1AFFFFFF" />
    <SolidColorBrush x:Key="FillHover" Color="#26FFFFFF" />
    <SolidColorBrush x:Key="Hairline" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="BorderSoft" Color="#1FFFFFFF" />
    <SolidColorBrush x:Key="BorderMid" Color="#2EFFFFFF" />
    <SolidColorBrush x:Key="BorderStrong" Color="#5C5A63" />
    <SolidColorBrush x:Key="TextPrimary" Color="#F5F5F7" />
    <SolidColorBrush x:Key="TextSecondary" Color="#C7C6CC" />
    <SolidColorBrush x:Key="TextDim" Color="#8E8D93" />
    <SolidColorBrush x:Key="Accent" Color="#FFD73D" />
    <SolidColorBrush x:Key="AccentHover" Color="#FFE068" />
    <SolidColorBrush x:Key="AccentPressed" Color="#EBC226" />
    <SolidColorBrush x:Key="AccentInk" Color="#1C1505" />
    <SolidColorBrush x:Key="AccentSubtle" Color="#33FF62AB" />
    <SolidColorBrush x:Key="Orchid" Color="#FF62AB" />
    <SolidColorBrush x:Key="Success" Color="#32D74B" />
    <SolidColorBrush x:Key="Warning" Color="#FF9F0A" />
    <SolidColorBrush x:Key="Danger" Color="#FF453A" />

    <!-- The Mac system face (SF Pro); Helvetica Neue and Inter cover other systems. -->
    <FontFamily x:Key="UiFont">SF Pro Text, .AppleSystemUIFont, Helvetica Neue</FontFamily>
    <FontFamily x:Key="DisplayFont">SF Pro Display, .AppleSystemUIFont, Helvetica Neue</FontFamily>
    <BoxShadows x:Key="CardShadow">0 10 30 0 #59000000</BoxShadows>
    <BoxShadows x:Key="HeroShadow">0 24 60 0 #80000000</BoxShadows>
    <BoxShadows x:Key="ArtShadow">0 16 36 0 #8C000000</BoxShadows>

    <!-- Icons: one 24×24 grid, one stroke weight. -->
    <StreamGeometry x:Key="IconLibrary">M3 20.5h18 M5 20.5V8.5h4v12 M10.5 20.5V5h4v15.5 M16 20.5l1.6-11.6 3.9.55-1.6 11.05</StreamGeometry>
    <StreamGeometry x:Key="IconEx">M4 8h14 M14.5 4.5L18 8l-3.5 3.5 M20 16H6 M9.5 12.5L6 16l3.5 3.5</StreamGeometry>
    <StreamGeometry x:Key="IconStore">M5 8.5h14l-1.2 12H6.2z M8.8 8.5V7a3.2 3.2 0 0 1 6.4 0v1.5</StreamGeometry>
    <StreamGeometry x:Key="IconHome">M3.5 11L12 4l8.5 7 M6 9.3v11.2h12V9.3 M10 20.5v-5.5h4v5.5</StreamGeometry>
    <StreamGeometry x:Key="IconSprint">M12 21a7.6 7.6 0 1 0 0-15.2 7.6 7.6 0 0 0 0 15.2z M12 9.5v4l2.6 1.8 M9.5 2.5h5 M12 2.5v3.3 M18.4 6.4l1.4-1.4</StreamGeometry>
    <StreamGeometry x:Key="IconAssets">M12 3l8 4.5v9L12 21l-8-4.5v-9z M4 7.5l8 4.5 8-4.5 M12 12v9</StreamGeometry>
    <StreamGeometry x:Key="IconSettings">M12 15.2a3.2 3.2 0 1 0 0-6.4 3.2 3.2 0 0 0 0 6.4z M10.3 3h3.4l.5 2.4 1.7 1 2.3-.8 1.7 2.9-1.8 1.6v2l1.8 1.6-1.7 2.9-2.3-.8-1.7 1-.5 2.4h-3.4l-.5-2.4-1.7-1-2.3.8-1.7-2.9 1.8-1.6v-2L4.1 8.5l1.7-2.9 2.3.8 1.7-1z</StreamGeometry>
    <StreamGeometry x:Key="IconPlay">M8 5.2v13.6L19 12z</StreamGeometry>
    <StreamGeometry x:Key="IconFolder">M3 7a2 2 0 0 1 2-2h4.2l2 2.2H19a2 2 0 0 1 2 2V18a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z</StreamGeometry>
    <StreamGeometry x:Key="IconTrash">M4 7h16 M9.5 7V4.5h5V7 M6.2 7l1 13h9.6l1-13 M10.2 11v5.5 M13.8 11v5.5</StreamGeometry>
    <StreamGeometry x:Key="IconPlus">M12 5v14 M5 12h14</StreamGeometry>
    <StreamGeometry x:Key="IconSearch">M10.8 17.6a6.8 6.8 0 1 0 0-13.6 6.8 6.8 0 0 0 0 13.6z M20 20l-4.4-4.4</StreamGeometry>
    <StreamGeometry x:Key="IconBack">M14.5 5.5L8 12l6.5 6.5</StreamGeometry>
    <StreamGeometry x:Key="IconForward">M9.5 5.5L16 12l-6.5 6.5</StreamGeometry>
    <StreamGeometry x:Key="IconReload">M19.5 12a7.5 7.5 0 1 1-2.2-5.3 M19.5 4.5v4.6h-4.6</StreamGeometry>
    <StreamGeometry x:Key="IconExternal">M13.5 4.5h6v6 M19.5 4.5l-8.5 8.5 M17.5 13.5v5a1 1 0 0 1-1 1h-11a1 1 0 0 1-1-1v-11a1 1 0 0 1 1-1h5</StreamGeometry>
    <StreamGeometry x:Key="IconWindows">M4 6l7-1v6.5H4z M13 4.7l7-1.2v8H13z M4 12.5h7V19l-7-1z M13 12.5h7v8l-7-1.2z</StreamGeometry>
    <StreamGeometry x:Key="IconMac">M4.5 5.5h15v10h-15z M2.5 18.5h19 M10 15.5l-.5 3 M14 15.5l.5 3</StreamGeometry>
    <StreamGeometry x:Key="IconFile">M6.5 3h7.5l4 4v14h-11.5z M14 3v4h4</StreamGeometry>
    <StreamGeometry x:Key="IconLock">M7 11h10v9H7z M9 11V8.5a3 3 0 0 1 6 0V11</StreamGeometry>
    <StreamGeometry x:Key="IconDownload">M12 4v11 M7.5 10.5L12 15l4.5-4.5 M5 19.5h14</StreamGeometry>
    <StreamGeometry x:Key="IconClose">M6.5 6.5l11 11 M17.5 6.5l-11 11</StreamGeometry>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />

    <Style Selector="TextBlock"><Setter Property="FontSize" Value="14" /></Style>
    <Style Selector="SelectableTextBlock">
      <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="TextBlock.secondary"><Setter Property="Foreground" Value="{DynamicResource TextSecondary}" /></Style>
    <Style Selector="TextBlock.dim"><Setter Property="Foreground" Value="{DynamicResource TextDim}" /></Style>
    <!-- Section labels: small, grey, sentence case — like macOS sidebars and System Settings. -->
    <Style Selector="TextBlock.eyebrow">
      <Setter Property="Foreground" Value="{DynamicResource TextDim}" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.display">
      <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="LetterSpacing" Value="-0.4" />
    </Style>
    <Style Selector="TextBlock.title">
      <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="FontSize" Value="17" />
    </Style>

    <Style Selector="Path.icon">
      <Setter Property="Width" Value="24" />
      <Setter Property="Height" Value="24" />
      <Setter Property="Stretch" Value="None" />
      <Setter Property="StrokeThickness" Value="1.7" />
      <Setter Property="StrokeLineCap" Value="Round" />
      <Setter Property="StrokeJoin" Value="Round" />
      <Setter Property="Stroke" Value="{DynamicResource TextSecondary}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Path.fill"><Setter Property="Fill" Value="{Binding $self.Stroke}" /></Style>

    <!-- Buttons: capsules on translucent fills; only hover/press feedback moves. -->
    <Style Selector="Button">
      <Setter Property="Background" Value="{DynamicResource Fill}" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="16,9" />
      <Setter Property="MinHeight" Value="36" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="RenderTransform" Value="none" />
      <Setter Property="Transitions">
        <Transitions><TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.16" Easing="CubicEaseOut" /></Transitions>
      </Setter>
    </Style>
    <Style Selector="Button /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.14" />
          <BrushTransition Property="BorderBrush" Duration="0:0:0.14" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource FillHover}" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
    </Style>
    <Style Selector="Button:pressed"><Setter Property="RenderTransform" Value="scale(0.97)" /></Style>
    <Style Selector="Button:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Hairline}" />
      <Setter Property="Foreground" Value="{DynamicResource TextDim}" />
    </Style>
    <Style Selector="Button:disabled Path.icon"><Setter Property="Stroke" Value="{DynamicResource BorderStrong}" /></Style>

    <Style Selector="Button.primary">
      <Setter Property="Background" Value="{DynamicResource Accent}" />
      <Setter Property="Foreground" Value="{DynamicResource AccentInk}" />
      <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <Style Selector="Button.primary Path.icon"><Setter Property="Stroke" Value="{DynamicResource AccentInk}" /></Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AccentHover}" />
      <Setter Property="Foreground" Value="{DynamicResource AccentInk}" />
    </Style>
    <Style Selector="Button.primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AccentPressed}" />
    </Style>
    <Style Selector="Button.primary:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#4DFFD73D" />
      <Setter Property="Foreground" Value="{DynamicResource AccentInk}" />
    </Style>
    <Style Selector="Button.outline">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderMid}" />
    </Style>
    <Style Selector="Button.outline Path.icon"><Setter Property="Stroke" Value="{DynamicResource Accent}" /></Style>
    <Style Selector="Button.pill"><Setter Property="CornerRadius" Value="18" /></Style>
    <Style Selector="Button.ghost">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
      <Setter Property="FontWeight" Value="Medium" />
    </Style>
    <Style Selector="Button.round">
      <Setter Property="Width" Value="48" />
      <Setter Property="Height" Value="48" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="24" />
      <Setter Property="Background" Value="{DynamicResource Fill}" />
    </Style>
    <Style Selector="Button.round:pointerover Path.icon"><Setter Property="Stroke" Value="{DynamicResource TextPrimary}" /></Style>
    <Style Selector="Button.small">
      <Setter Property="Width" Value="34" />
      <Setter Property="Height" Value="34" />
      <Setter Property="MinHeight" Value="34" />
      <Setter Property="CornerRadius" Value="17" />
      <Setter Property="Background" Value="Transparent" />
    </Style>

    <!-- Sidebar rows: a rounded filled highlight, like Finder and Music. -->
    <Style Selector="Button.nav">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Height" Value="34" />
      <Setter Property="MinHeight" Value="34" />
      <Setter Property="Padding" Value="10,0" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
    </Style>
    <Style Selector="Button.nav Path.icon"><Setter Property="Stroke" Value="{DynamicResource Orchid}" /><Setter Property="Width" Value="24" /></Style>
    <Style Selector="Button.nav:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Hairline}" />
    </Style>
    <Style Selector="Button.nav.selected /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Fill}" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
    </Style>
    <Style Selector="Button.nav.selected"><Setter Property="FontWeight" Value="SemiBold" /></Style>
    <Style Selector="Button.nav:pressed"><Setter Property="RenderTransform" Value="none" /></Style>

    <!-- Segmented control for the shelf. -->
    <Style Selector="Border.segmented">
      <Setter Property="Background" Value="{DynamicResource Fill}" />
      <Setter Property="CornerRadius" Value="9" />
      <Setter Property="Padding" Value="2" />
    </Style>
    <Style Selector="Button.segment">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="MinHeight" Value="28" />
      <Setter Property="Padding" Value="14,4" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
    </Style>
    <Style Selector="Button.segment:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
    </Style>
    <Style Selector="Button.segment.selected /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SurfaceHover}" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
    </Style>
    <Style Selector="Button.segment:pressed"><Setter Property="RenderTransform" Value="none" /></Style>

    <!-- Game artwork cards: lift on hover, a pink ring marks the open game. -->
    <Style Selector="Button.tile">
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Stretch" />
      <Setter Property="CornerRadius" Value="0" />
    </Style>
    <Style Selector="Button.tile:pointerover /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="Transparent" /></Style>
    <Style Selector="Button.tile:pressed /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="Transparent" /></Style>
    <Style Selector="Button.tile:pointerover"><Setter Property="RenderTransform" Value="translateY(-4px) scale(1.02)" /></Style>
    <Style Selector="Button.tile:pressed"><Setter Property="RenderTransform" Value="scale(0.98)" /></Style>
    <Style Selector="Button.tile Border.art">
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Button.tile.selected Border.art"><Setter Property="BorderBrush" Value="{DynamicResource Orchid}" /></Style>
    <Style Selector="Button.addtile">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="22" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Button.addtile:pointerover /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{DynamicResource Hairline}" /></Style>
    <Style Selector="Button.addtile:pointerover Rectangle"><Setter Property="Stroke" Value="{DynamicResource Orchid}" /></Style>

    <Style Selector="Button.platform">
      <Setter Property="Background" Value="{DynamicResource Fill}" />
      <Setter Property="BorderThickness" Value="1.5" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="14,12" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="FontWeight" Value="Normal" />
    </Style>
    <Style Selector="Button.platform.selected /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AccentSubtle}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Orchid}" />
    </Style>
    <Style Selector="Button.platform.selected Path.icon"><Setter Property="Stroke" Value="{DynamicResource Orchid}" /></Style>

    <!-- Cards are inset groups with a hairline and a soft drop shadow. -->
    <Style Selector="Border.card">
      <Setter Property="Background" Value="{DynamicResource Surface}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Hairline}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="16" />
      <Setter Property="Padding" Value="22" />
      <Setter Property="BoxShadow" Value="{StaticResource CardShadow}" />
    </Style>
    <Style Selector="Border.chip">
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="9,3" />
      <Setter Property="Background" Value="{DynamicResource Fill}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBox">
      <Setter Property="Background" Value="{DynamicResource Fill}" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
      <Setter Property="CornerRadius" Value="9" />
      <Setter Property="MinHeight" Value="36" />
      <Setter Property="Padding" Value="12,8" />
      <Setter Property="SelectionBrush" Value="#66FF62AB" />
      <Setter Property="CaretBrush" Value="{DynamicResource Orchid}" />
    </Style>
    <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="{DynamicResource FillHover}" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="{DynamicResource Fill}" />
      <Setter Property="BorderBrush" Value="#99FF62AB" />
      <Setter Property="BorderThickness" Value="2" />
    </Style>
    <Style Selector="TextBox /template/ TextBlock#PART_Watermark, TextBox /template/ TextBlock#PART_FloatingWatermark">
      <Setter Property="Foreground" Value="{DynamicResource TextDim}" />
    </Style>
    <Style Selector="TextBox.search">
      <Setter Property="CornerRadius" Value="9" />
      <Setter Property="Padding" Value="34,8,12,8" />
    </Style>
    <Style Selector="ComboBox">
      <Setter Property="Background" Value="{DynamicResource Fill}" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
      <Setter Property="CornerRadius" Value="9" />
      <Setter Property="MinHeight" Value="36" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>
    <Style Selector="ComboBox:pointerover /template/ Border#Background">
      <Setter Property="Background" Value="{DynamicResource FillHover}" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Expander">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Expander /template/ ToggleButton#ExpanderHeader">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
    </Style>
    <Style Selector="ProgressBar">
      <Setter Property="Foreground" Value="{DynamicResource Orchid}" />
      <Setter Property="Background" Value="{DynamicResource Fill}" />
      <Setter Property="MinHeight" Value="4" />
      <Setter Property="CornerRadius" Value="2" />
    </Style>
    <Style Selector="ScrollViewer"><Setter Property="AllowAutoHide" Value="True" /></Style>
  </Application.Styles>
</Application>
